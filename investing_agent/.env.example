# Copy this file to investing_agent/.env for local-only testing.
# Never commit a real API key. The repository .gitignore excludes .env files.

RAPIDAPI_KEY=replace_with_your_rapidapi_key
RAPIDAPI_HOST=replace_with_rapidapi_host
RAPIDAPI_QUOTE_URL=https://replace-with-rapidapi-quote-endpoint.example.com/quote?symbol={symbol}

# Optional fallback provider key. Leave blank if unused.
ALPHAVANTAGE_API_KEY=
